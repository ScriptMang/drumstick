{{define "posts"}}
<!DOCTYPE html>
<html lang='en'>
  <head>
     <meta charset='utf-8'>
     <title>Posts</title>
     <link rel='stylesheet' href="static/drumstick.css">
  </head>
<body>

    <header>
        <h1>View Posts</h1>
    </header>

  
   <p> Welcome {{.Username}}, to your Posts page</p>
   <a href="/"> sign out</a><br>
   
 <form action= "/posts" method="post">   
     <label for="content">write post</label><br>
     <textarea id="content" name="content" rows="8" cols="50" maxlength="140"></textarea><br>
      <input type="submit" value="submit">
    </form>


    <h3> My Feed</h3>
  <hr class="post-separator">
  {{range .Posts}}
  <div class="posts">

    <div class="posts-row">
      <div class="posts-item">
        <p><strong>{{.Username}}</strong></p>
      </div>

        <div class="posts-item">
          <p><strong>{{.Date}}</strong></p>
        </div>
     </div>

      <div class="posts-body">
        <p>{{.Content}}</p>
      </div>

      <div class="meta-item">
        <form action="/posts/{{.ID}}" method="post" style="display:inline;">
         <input type="hidden" name="_method" value="DELETE">
          <button type="submit" class="delete-bttn">delete</button>
        </form>
        <a href="/posts/{{.ID}}/reply"><button type="button">Reply</button></a>
      </div>
   </div>

   <hr class="posts-separator bottom-separator">
   {{end}}

  </body>
</html>
{{end}}
