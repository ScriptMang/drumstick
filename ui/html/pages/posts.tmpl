{{define "posts"}}
<!DOCTYPE html>
<html lang='en'>
  <head>
     <meta charset='utf-8'>
     <title>Posts</title>
     <link rel='stylesheet' href='https://fonts.google.apis.com/css?family=Ubuntu+Mono:400,700'>
  </head>
  <body>
    <header>
        <h1>View Posts</h1>
    </header>
  
   <p> This is the User's Posts page</p>
   <a href="/"> sign out</a><br>
   
 <form action= "/refresh" method="post">   
     <label for="content">write post</label><br>
     <textarea id="content" name="content" rows="8" cols="50" maxlength="140"></textarea><br>
      <input type="submit" value="submit">
    </form>


    <h3> My Feed</h3>
    <hr>

  {{range .Posts}}
   <div name="post-container" style="margin-bottom: 5rem">

    <div name="post-top-div">
      <p><strong>{{.Username}}</strong></p>
    </div>

    <div name="post-center-div" style="margin-bototm: 4rem; margin-left: 1rem">
      <p>{{.Content}}</p>
    </div>

   </div>
   <hr>
   {{end}}


  </body>
</html>
{{end}}
