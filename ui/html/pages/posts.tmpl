{{define "posts"}}
<!DOCTYPE html>
<html lang='en'>
  <head>
     <meta charset='utf-8'>
     <title>Posts</title>
     <link rel='stylesheet' href='https://fonts.google.apis.com/css?family=Ubuntu+Mono:400,700'>
  </head>
  <body>
    <header>
        <h1>View Posts</h1>
    </header>

    <p> This is the User's Posts page</p><br>
    <p>{{.}}</p>
    <form action= "/view" method="post">   
     <label for="content">write post</label><br>
     <textarea id="content" name="content" rows="8" cols="50" maxlength="140"></textarea><br>
      <input type="submit" value="submit">
    </form>
    
    <a href="/"> sign out</a>  
    </body>
</html>

{{end}}
